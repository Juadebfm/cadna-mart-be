generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// IDs remain 24-character hexadecimal strings so existing API IDs and tokens
// keep their current format during the persistence migration.
model User {
  id                       String    @id @db.VarChar(24)
  firstName                String
  lastName                 String
  email                    String?   @unique
  password                 String?
  accountType              String
  authProvider             String    @default("local")
  clerkId                  String?   @unique
  phoneNumber              String?
  isPhoneVerified          Boolean   @default(false)
  dateOfBirth              DateTime?
  gender                   String?
  avatarUrl                String?
  avatarPublicId           String?
  notificationPreferences  Json      @default("{\"orderUpdates\":true,\"promotions\":false,\"newsletter\":false,\"securityAlerts\":true}")
  isVerified               Boolean   @default(false)
  isActive                 Boolean   @default(true)
  isTwoFactorEnabled       Boolean   @default(false)
  termsAcceptedAt          DateTime?
  lastLoginAt              DateTime?
  marketingConsentAt       DateTime?
  refreshToken             String?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  addresses                Address[]
  seller                   Seller?
  sellerProfile            SellerProfile?
  approvedSellerProfiles   SellerProfile[] @relation("SellerApprover")
  orders                   Order[]
  carts                    Cart[]
  reviews                  Review[]
  wishlistItems            WishlistItem[]
  authEvents               AuthEvent[]
  otpRecords               Otp[]
  dataRequests             DataRequest[] @relation("DataRequestOwner")
  processedDataRequests    DataRequest[] @relation("DataRequestProcessor")

  @@index([phoneNumber])
  @@index([accountType, isActive])
  @@map("users")
}

model Category {
  id          String     @id @db.VarChar(24)
  name        String
  slug        String     @unique
  iconUrl     String?
  parentId    String?    @db.VarChar(24)
  productCount Int       @default(0)
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]  @relation("ProductCategory")
  subProducts Product[]  @relation("ProductSubCategory")

  @@index([parentId, isActive, order])
  @@map("categories")
}

model Seller {
  id                  String    @id @db.VarChar(24)
  name                String
  slug                String    @unique
  logoUrl             String?
  ownerId             String    @unique @db.VarChar(24)
  isVerified          Boolean   @default(false)
  responseRatePercent Float     @default(0)
  averageRating       Float     @default(0)
  reviewCount         Int       @default(0)
  followerCount       Int       @default(0)
  joinedYear          Int?
  location            String?
  deliveryTimeRange   String?
  isActive            Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products            Product[]
  deals               DealCampaign[]

  @@index([isActive, isVerified])
  @@map("stores")
}

model SellerProfile {
  id                       String    @id @db.VarChar(24)
  userId                   String    @unique @db.VarChar(24)
  businessName             String
  businessRegistrationNumber String?
  businessAddress          String
  businessType             String
  bankName                 String?
  bankAccountNumber        String?
  bankAccountName          String?
  bankDetailsCompletedAt   DateTime?
  isApproved               Boolean   @default(false)
  approvedAt               DateTime?
  approvedById             String?   @db.VarChar(24)
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy               User?     @relation("SellerApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("seller_profiles")
}

model Product {
  id                String    @id @db.VarChar(24)
  name              String
  slug              String    @unique
  sku               String?
  brand             String?
  thumbnailUrl      String?
  price             Json
  originalPrice     Json?
  discountPercent   Float     @default(0)
  savings           Json?
  gallery           Json     @default("[]")
  variantAxes       Json     @default("[]")
  variants          Json     @default("[]")
  defaultVariantId  String?
  descriptionHtml   String?
  tabs              Json     @default("[]")
  specifications    Json     @default("[]")
  breadcrumbs       Json     @default("[]")
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  inventoryStatus   String   @default("in_stock")
  badge             String?
  categoryId        String?  @db.VarChar(24)
  subCategoryId     String?  @db.VarChar(24)
  sellerId          String   @db.VarChar(24)
  returnPolicy      Json?
  sections          String[] @default([])
  isActive          Boolean  @default(true)
  moderationStatus  String   @default("approved")
  moderationReason  String?
  moderatedAt       DateTime?
  salesCount        Int      @default(0)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          Category? @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory       Category? @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull)
  seller            Seller    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]

  @@index([sellerId, isActive])
  @@index([categoryId, isActive])
  @@index([moderationStatus, isActive])
  @@map("products")
}

model Address {
  id            String    @id @db.VarChar(24)
  userId        String    @db.VarChar(24)
  label         String?
  recipientName String
  phoneNumber   String
  street1       String
  street2       String?
  city          String
  state         String
  country       String    @default("Nigeria")
  postalCode    String?
  notes         String?
  isDefault     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([userId, isDefault])
  @@map("addresses")
}

model Order {
  id                       String    @id @db.VarChar(24)
  orderRef                 String    @unique
  userId                   String?   @db.VarChar(24)
  guestEmail               String?
  guestPhone               String?
  items                    Json      @default("[]")
  deliveryAddress          Json
  deliveryMode             String    @default("standard")
  pickupDetails            Json?
  pricing                  Json
  status                   String    @default("pending_payment")
  paymentStatus            String    @default("unpaid")
  paymentMethod            String?
  paystackReference        String?
  refundedAmount           Float     @default(0)
  reservedRefundAmount     Float     @default(0)
  returnQuantityReservations Json    @default("[]")
  refundInProgressRequestId String?
  timeline                 Json      @default("[]")
  tracking                 Json      @default("[]")
  cancelReason             String?
  cancelledAt              DateTime?
  cartRef                  String?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user                     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  returnRequests           ReturnRequest[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model Cart {
  id            String    @id @db.VarChar(24)
  publicCartId  String    @unique
  ownerType     String    @default("user")
  userId        String?   @db.VarChar(24)
  guestTokenHash String?
  expiresAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]

  @@index([userId, deletedAt])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @db.VarChar(24)
  cartId    String   @db.VarChar(24)
  productId String   @db.VarChar(24)
  variantId String?
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@map("cart_items")
}

model Review {
  id          String    @id @db.VarChar(24)
  productId   String    @db.VarChar(24)
  userId      String    @db.VarChar(24)
  rating      Int
  title       String?
  comment     String    @default("")
  isVerified  Boolean   @default(false)
  helpfulCount Int      @default(0)
  status      String    @default("approved")
  moderationReason String?
  moderatedAt DateTime?
  moderatedById String? @db.VarChar(24)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @db.VarChar(24)
  userId    String   @db.VarChar(24)
  productId String   @db.VarChar(24)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model AuthEvent {
  id        String   @id @db.VarChar(24)
  userId    String?  @db.VarChar(24)
  kind      String
  succeeded Boolean  @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("auth_events")
}

model Otp {
  id        String   @id @db.VarChar(24)
  userId    String?  @db.VarChar(24)
  email     String
  code      String
  type      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, type, isUsed])
  @@index([expiresAt])
  @@map("otps")
}

model DataRequest {
  id          String   @id @db.VarChar(24)
  userId      String   @db.VarChar(24)
  kind        String
  status      String   @default("pending")
  processedById String? @db.VarChar(24)
  processedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("DataRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User?    @relation("DataRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, kind, status])
  @@index([status])
  @@map("data_requests")
}

model RegistrationSession {
  id            String   @id @db.VarChar(24)
  sessionId     String   @unique
  email         String
  firstName     String?
  lastName      String?
  dateOfBirth   DateTime?
  phoneNumber   String?
  termsAccepted Boolean  @default(false)
  currentStep   Int      @default(1)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
  @@map("registration_sessions")
}

model PendingBuyerSignup {
  id            String   @id @db.VarChar(24)
  email         String   @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  phoneNumber   String?
  passwordHash  String
  termsAccepted Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
  @@map("pending_buyer_signups")
}

model NewsletterSubscription {
  id        String   @id @db.VarChar(24)
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscriptions")
}

model Banner {
  id             String    @id @db.VarChar(24)
  type           String
  title          String
  subtitle       String?
  description    String?
  imageUrl       String?
  mobileImageUrl String?
  ctaLabel       String?
  ctaUrl         String?
  discountLabel  String?
  startAt        DateTime?
  endAt          DateTime?
  locations      String[]  @default([])
  order          Int       @default(0)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type, isActive, order])
  @@map("banners")
}

model DealCampaign {
  id                String   @id @db.VarChar(24)
  sellerId          String   @db.VarChar(24)
  title             String
  data              Json
  status            String   @default("draft")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seller            Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@map("deal_campaigns")
}

model ReturnRequest {
  id        String   @id @db.VarChar(24)
  orderId   String   @db.VarChar(24)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("return_requests")
}
